<div class="page-shell">
  <div class="container">
    <div class="page-card">
      <h1 style="margin-top:0;">Admin Dashboard</h1>
      <div class="feature-row" style="margin-bottom: 24px;">
        <div class="feature-box">
          <h3>Total Order</h3>
          <strong><%= stats.totalOrders %></strong>
        </div>
        <div class="feature-box">
          <h3>Revenue</h3>
          <strong>Rp <%= Number(stats.revenue || 0).toLocaleString('id-ID') %></strong>
        </div>
        <div class="feature-box">
          <h3>Pending</h3>
          <strong><%= stats.pendingOrders %></strong>
        </div>
      </div>

      <h2>Pesanan terkini</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Nomor</th>
              <th>Pelanggan</th>
              <th>Game</th>
              <th>Status</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach((order) => { %>
              <tr>
                <td><a href="/orders/<%= order.order_number %>"><%= order.order_number %></a></td>
                <td><%= order.user_name %></td>
                <td><%= order.game %></td>
                <td><span class="status-badge status-<%= order.order_status %>"><%= order.order_status %></span></td>
                <td>Rp <%= Number(order.total_amount).toLocaleString('id-ID') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <h2 style="margin-top: 32px;">Aktivitas admin</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Waktu</th>
              <th>Aksi</th>
              <th>Detail</th>
            </tr>
          </thead>
          <tbody>
            <% activities.forEach((item) => { %>
              <tr>
                <td><%= new Date(item.created_at).toLocaleString('id-ID') %></td>
                <td><%= item.action %></td>
                <td><%= item.details %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
