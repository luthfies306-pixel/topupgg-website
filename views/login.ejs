<div class="page-shell">
  <div class="container">
    <div class="page-card">
      <h1 style="margin-top:0;">Masuk</h1>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="glass-panel" style="color:#ffb1b6; margin-bottom: 18px;"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <input type="hidden" name="next" value="<%= typeof nextPath !== 'undefined' ? nextPath : '/' %>" />
        <div class="form-grid">
          <div class="form-field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required />
          </div>
          <div class="form-field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" required />
          </div>
          <button class="btn btn-primary" type="submit">Masuk</button>
        </div>
      </form>
      <div class="meta" style="margin-top: 18px;">Belum punya akun? <a href="/register">Daftar sekarang</a></div>
    </div>
  </div>
</div>
