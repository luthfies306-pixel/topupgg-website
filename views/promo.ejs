<div class="page-shell">
  <div class="container">
    <div class="page-card">
      <h1 style="margin-top:0;">Promo & Redeem Kode</h1>
      <form data-promo-form>
        <div class="form-grid">
          <div class="form-row">
            <div class="form-field">
              <label for="promoCode">Kode Promo</label>
              <input id="promoCode" name="code" type="text" placeholder="TOPUPGG10" />
            </div>
            <div class="form-field">
              <label for="promoAmount">Total Pembelian</label>
              <input id="promoAmount" name="amount" type="number" min="0" value="100000" />
            </div>
          </div>
          <button class="btn btn-primary" type="submit">Validasi Kode</button>
        </div>
      </form>
      <div data-promo-result style="margin-top: 18px;"></div>
    </div>
  </div>
</div>
